src/cppgame/*.exe
*.obj
*.o
*.ilk
*.exp

# Debug symbols, except the prebuilt GLFW one
*.pdb
!src/libraries/lib/*.pdb

# Visual Studio
.vs/
*.vcxproj.user

# VS Code: keep shared config, ignore personal stuff
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
.cache/

# OS
Thumbs.db
desktop.ini

*deleteme*
*.exe